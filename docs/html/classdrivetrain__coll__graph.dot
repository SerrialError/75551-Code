digraph "drivetrain"
{
 // LATEX_PDF_SIZE
  bgcolor="transparent";
  edge [fontname=Helvetica,fontsize=10,labelfontname=Helvetica,labelfontsize=10];
  node [fontname=Helvetica,fontsize=10,shape=box,height=0.2,width=0.4];
  Node1 [id="Node000001",label="drivetrain",height=0.2,width=0.4,color="gray40", fillcolor="grey60", style="filled", fontcolor="black",tooltip="Main drivetrain class for holonomic robot control."];
  Node2 -> Node1 [id="edge1_Node000001_Node000002",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">motors</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node2 [id="Node000002",label="wheels\< MotorController \>",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structwheels.html",tooltip=" "];
  Node3 -> Node2 [id="edge2_Node000002_Node000003",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">m1</TD></TR>
<TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">m2</TD></TR>
<TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">m3</TD></TR>
<TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">m4</TD></TR>
<TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">o1</TD></TR>
<TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">o2</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node3 [id="Node000003",label="MotorController",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classMotorController.html",tooltip="Individual motor controller with feedforward control."];
  Node4 -> Node3 [id="edge3_Node000003_Node000004",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">motor_ff</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node4 [id="Node000004",label="DCff",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classDCff.html",tooltip="DC motor feedforward controller."];
  Node5 -> Node4 [id="edge4_Node000004_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">constants</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node5 [id="Node000005",label="ff_constants",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structff__constants.html",tooltip="Feedforward motor constants."];
  Node5 -> Node3 [id="edge5_Node000003_Node000005",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">motor_constants</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node6 -> Node1 [id="edge6_Node000001_Node000006",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">localization</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node6 [id="Node000006",label="Localization",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classLocalization.html",tooltip="Robot pose estimation using odometry sensors."];
  Node7 -> Node6 [id="edge7_Node000006_Node000007",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">Pose</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node7 [id="Node000007",label="pose",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$structpose.html",tooltip="Robot pose in 2D space."];
  Node8 -> Node1 [id="edge8_Node000001_Node000008",dir="back",color="darkorchid3",style="dashed",tooltip=" ",label=<<TABLE CELLBORDER="0" BORDER="0"><TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">AngularMP</TD></TR>
<TR><TD VALIGN="top" ALIGN="LEFT" CELLPADDING="1" CELLSPACING="0">LinearMP</TD></TR>
</TABLE>> ,fontcolor="grey" ];
  Node8 [id="Node000008",label="mp",height=0.2,width=0.4,color="gray40", fillcolor="white", style="filled",URL="$classmp.html",tooltip="Motion profiler for generating smooth velocity trajectories."];
}
